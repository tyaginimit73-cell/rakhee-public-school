# Rakhee Public School — backend environment variables
#
# Copy this file to `.env` in the server/ folder and fill in real values.
# Never commit the real `.env` file — it's already in .gitignore.
#
# This file lists every environment variable the code actually reads
# (verified by grepping the codebase, not guessed). See PROJECT_AUDIT.md
# for the full reasoning behind the production-specific requirements below.

# ---------------------------------------------------------------------------
# REQUIRED IN EVERY ENVIRONMENT
# ---------------------------------------------------------------------------

# Secret used to sign JWTs (login sessions AND the short-lived admission
# document-upload tokens). Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production this must be at least 32 characters — the server refuses
# to start otherwise (see config/validateEnv.js).
JWT_SECRET=

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (NODE_ENV=production) — the server refuses to
# start without these; see config/validateEnv.js. Optional in development.
# ---------------------------------------------------------------------------

# Your real MongoDB connection string. Without this in production, the
# server used to silently fall back to a throwaway in-memory database with
# a well-known demo admin password — it now refuses to start instead.
# Example: mongodb+srv://user:password@cluster.mongodb.net/rakhee_public_school
MONGODB_URI=

# The exact origin(s) of your deployed frontend, comma-separated if there's
# more than one (e.g. with and without "www"). Used for the CORS allowlist —
# requests from any other origin are rejected. No trailing slash.
# Example: https://www.rakheepublicschool.in,https://rakheepublicschool.in
CLIENT_URL=

# Email + password for the initial admin account, created automatically the
# first time the server connects to an empty database. Both are required
# in production — there is no hardcoded fallback for either one there (not
# just the password; a predictable default email is also a weakness even
# with a strong password). Change the password immediately after first
# login if you ever need to reset it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Standard Node environment flag. Leave unset (or "development") for local
# dev. Set to exactly "production" when deploying — this is what activates
# every production-specific check described above, secure cookies, and
# suppressed stack traces in error responses.
NODE_ENV=development

# Port the API listens on. Defaults to 5000 if not set.
PORT=5000

# How long a login session (JWT + cookie) stays valid. Defaults to "7d".
# Accepts jsonwebtoken-style duration strings (e.g. "1h", "30m", "7d").
JWT_EXPIRES_IN=7d

# Whether to auto-create demo content (fake teachers/students/notices/a
# demo parent login) on first boot against an empty database.
#   - Development default: on (unless explicitly set to "false")
#   - Production default: OFF — set to exactly "true" to opt in. A real
#     school's production database should start with just an admin account
#     and site settings, then be populated with real data through the
#     admin dashboard, not filled with fake students automatically.
SEED_DEMO_DATA=true
